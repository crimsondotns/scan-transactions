# ค่าตั้งต้นที่ฝังตอน build — ใส่ผ่าน GitHub Secrets (ดู docs/build-config.md)
# ⚠️ เว็บนี้เป็น static: ทุกค่า VITE_* จะอยู่ในไฟล์ JS ใน dist/ ที่ทุกคนเปิดอ่านได้
#    GitHub Secrets ช่วยแค่ไม่ให้ URL อยู่ในซอร์ส ไม่ได้ทำให้เป็นความลับหลัง deploy

# แหล่งข้อมูล (JSON array) — url ต้องมี {address} หรือปล่อยให้แอปประกอบ query ให้
VITE_SOURCES=

# URL รายชื่อเชน
VITE_CHAIN_LIST_URL=

# เชนที่กำหนดเอง (JSON array): [{"id":"eth","name":"Ethereum","logo":"https://…","explorer":"https://…"}]
VITE_CHAINS=
