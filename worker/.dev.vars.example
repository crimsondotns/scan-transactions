# คัดลอกเป็น .dev.vars สำหรับ `wrangler dev` เท่านั้น — ห้าม commit ไฟล์ .dev.vars
# ทุกค่าด้านล่างเป็นตัวอย่าง ใส่ค่าจริงเองในเครื่อง/ใน secret store ของ Cloudflare
ALLOWED_ORIGINS=http://localhost:5174
RATE_LIMIT_PER_MIN=60

# ปลายทางหนึ่งชุดต่อหนึ่งชื่อย่อ (alias) — หน้าเว็บอ้างถึงด้วยชื่อย่อเท่านั้น
# UPSTREAM_<ALIAS>_BASE       = URL ฐานของ API ภายนอก (ถือเป็นความลับ: ไม่อยู่ในหน้าเว็บ)
# UPSTREAM_<ALIAS>_AUTH_HEADER= ชื่อ header ที่ปลายทางต้องการ (ไม่ลับ)
# UPSTREAM_<ALIAS>_KEY        = กุญแจ (ความลับ)
UPSTREAM_MAIN_BASE=https://example.invalid/v1
UPSTREAM_MAIN_AUTH_HEADER=x-api-key
UPSTREAM_MAIN_KEY=replace-with-your-own-key
